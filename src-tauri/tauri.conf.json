{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pawgress",
  "version": "0.4.0",
  "identifier": "com.northernarchive.pawgress",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Pawgress",
        "width": 280,
        "height": 380,
        "minWidth": 200,
        "minHeight": 260,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; connect-src 'self' blob: ipc: http://ipc.localhost; worker-src blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
